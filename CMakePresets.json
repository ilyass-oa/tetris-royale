{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 22, "patch": 0},
  "configurePresets": [
    {"name": "desktop", "displayName": "Desktop client, server and tests", "binaryDir": "${sourceDir}/build/desktop", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON", "TETRIS_BUILD_GUI": "ON"}},
    {"name": "headless", "displayName": "Server and regression tests", "binaryDir": "${sourceDir}/build/headless", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON", "TETRIS_BUILD_GUI": "OFF"}},
    {"name": "sanitize", "inherits": "headless", "displayName": "Address and undefined behavior sanitizers", "binaryDir": "${sourceDir}/build/sanitize", "cacheVariables": {"TETRIS_SANITIZERS": "ON"}}
  ],
  "buildPresets": [{"name": "desktop", "configurePreset": "desktop"}, {"name": "headless", "configurePreset": "headless"}, {"name": "sanitize", "configurePreset": "sanitize"}],
  "testPresets": [
    {"name": "desktop", "configurePreset": "desktop", "output": {"outputOnFailure": true}},
    {"name": "headless", "configurePreset": "headless", "output": {"outputOnFailure": true}},
    {"name": "sanitize", "configurePreset": "sanitize", "output": {"outputOnFailure": true}}
  ]
}
